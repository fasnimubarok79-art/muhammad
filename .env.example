# ClipKita-Pro configuration. Names use the CKP_ prefix; older unprefixed names are still accepted.
# DATABASE_URL keeps its standard name because Prisma and the PostgreSQL tools read it directly.

# --- required ---
DATABASE_URL=postgresql://clipkita:CHANGE_ME@127.0.0.1:5432/clipkita_pro
CKP_APP_URL=http://localhost:3000
CKP_STORAGE_DIR=/var/lib/clipkita-pro/storage
# 32+ random chars: openssl rand -hex 32
CKP_SECRET_KEY=
# Owner admin bootstrap (npm run db:seed). Password must be changed at first login (min 8 chars).
CKP_OWNER_EMAIL=ADMIN16112000@gmail.com
CKP_OWNER_USERNAME=ADMINPRO16112000
CKP_OWNER_NAME=Muhammad Fasni Mubarok
CKP_OWNER_INITIAL_PASSWORD=

# --- speech recognition (worker) ---
# faster-whisper model name (downloaded on first use) or a local CTranslate2 model directory.
CKP_WHISPER_MODEL=small
CKP_WHISPER_PYTHON=/opt/clipkita-pro/.venv/bin/python
# CKP_WHISPER_LANGUAGE=id   # leave empty to auto-detect
# CKP_WHISPER_THREADS=4

# --- limits ---
CKP_MAX_UPLOAD_MB=500
CKP_MAX_SOURCE_MINUTES=120
CKP_JOB_TIMEOUT_MIN=60
# CKP_WORKER_CONCURRENCY=1
# CKP_TRUST_PROXY=1          # only behind your own reverse proxy

# --- link import (yt-dlp): public videos only, after the user confirms rights ---
CKP_LINK_IMPORT=1
# CKP_YTDLP_PYTHON=          # defaults to CKP_WHISPER_PYTHON
# CKP_YTDLP_JS_RUNTIME=node  # YouTube needs a JavaScript runtime

# --- optional (unset = feature unavailable) ---
# CKP_FFMPEG_PATH=ffmpeg
# CKP_FFPROBE_PATH=ffprobe
# CKP_FACE_MODEL=            # YuNet ONNX file for better face tracking (Haar is used otherwise)
# CKP_META_APP_TOKEN=        # Instagram/Facebook oEmbed previews
# CKP_SMTP_URL=              # password reset email (transport not implemented yet)
# CKP_YOUTUBE_CLIENT_ID= / CKP_YOUTUBE_CLIENT_SECRET=
# CKP_TIKTOK_CLIENT_KEY= / CKP_TIKTOK_CLIENT_SECRET=
# CKP_META_APP_ID= / CKP_META_APP_SECRET=
# CKP_BACKUP_DIR= / CKP_BACKUP_KEY_FILE=
