# --- required ---
DATABASE_URL=postgresql://clipkita:CHANGE_ME@127.0.0.1:5432/clipkita
APP_URL=http://localhost:3000
STORAGE_DIR=/var/lib/clipkita/storage
# 32+ random chars: openssl rand -hex 32
SECRET_KEY=
# Owner admin bootstrap (npm run db:seed). Password must be changed at first login.
OWNER_EMAIL=ADMIN16112000@gmail.com
OWNER_USERNAME=ADMINPRO16112000
OWNER_INITIAL_PASSWORD=

# --- speech recognition (worker) ---
# A faster-whisper model name (downloaded from Hugging Face on first use) or a local CTranslate2 model directory.
WHISPER_MODEL=small
WHISPER_PYTHON=/opt/clipkita/.venv/bin/python
# WHISPER_LANGUAGE=id   # leave empty to auto-detect
# WHISPER_THREADS=4

# --- limits ---
MAX_UPLOAD_MB=500
MAX_SOURCE_MINUTES=120
JOB_TIMEOUT_MIN=60
# WORKER_CONCURRENCY=1
# TRUST_PROXY=1          # only behind your own reverse proxy

# --- optional integrations (not configured = feature shows as unavailable) ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Link import: public YouTube/TikTok/Instagram/Facebook videos are fetched with yt-dlp after the
# user confirms they have the rights. Set to 0 to disable. Keep yt-dlp updated (pip install -U yt-dlp[default]).
LINK_IMPORT=1
# YTDLP_PYTHON=          # defaults to WHISPER_PYTHON
# YTDLP_JS_RUNTIME=node  # YouTube needs a JavaScript runtime
# META_APP_TOKEN=        # Instagram/Facebook oEmbed previews
# SMTP_URL=              # password reset email (transport not implemented yet)
# YOUTUBE_CLIENT_ID= / YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY= / TIKTOK_CLIENT_SECRET=
# META_APP_ID= / META_APP_SECRET=
