generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER_ADMIN
}

enum JobStatus {
  queued
  validating
  downloading
  analyzing
  transcribing
  editing
  rendering
  completed
  failed
  cancelled
}

enum JobKind {
  ANALYZE
  RENDER
}

enum SourceKind {
  UPLOAD
  URL
}

enum AccessState {
  PROCESSABLE
  PREVIEW_ONLY
  AUTHORIZATION_REQUIRED
  UNSUPPORTED
}

enum TokenTxType {
  GRANT
  RESERVE
  CAPTURE
  REFUND
  CHARGE
  ADJUST
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String?   @unique // stored upper-case; currently only the owner admin has one
  name               String?
  passwordHash       String
  role               Role      @default(USER)
  mustChangePassword Boolean   @default(false)
  disabledAt         DateTime?
  tokenBalance       Int       @default(0)
  signupGrantedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  projects       Project[]
  tokenTxs       TokenTransaction[]
  socialAccounts SocialAccount[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id // sha256 of the cookie value, never the raw value
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id // sha256 of the emailed token
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVideos SourceVideo[]
  clips        Clip[]
  jobs         RenderJob[]

  @@index([userId])
}

model SourceVideo {
  id           String      @id @default(cuid())
  projectId    String
  kind         SourceKind
  platform     String // upload | youtube | tiktok | instagram | facebook | direct
  sourceUrl    String?
  accessState  AccessState
  accessReason String?
  embedUrl     String?
  originalName String?
  storageKey   String? // relative path inside STORAGE_DIR, null when not processable
  mimeType     String?
  sizeBytes    BigInt?
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  hasAudio     Boolean?
  analysis     Json? // { silences: [{start,end}], scenes: [sec] } from ffmpeg silencedetect / scdet
  createdAt    DateTime    @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcript Transcript?
  clips      Clip[]
  jobs       RenderJob[]

  @@index([projectId])
}

model Transcript {
  id            String   @id @default(cuid())
  sourceVideoId String   @unique
  language      String?
  engine        String // e.g. faster-whisper:small
  text          String
  wordsJson     Json // [{w,s,e,p}] word timestamps from the model
  createdAt     DateTime @default(now())

  sourceVideo SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
}

model Clip {
  id              String   @id @default(cuid())
  projectId       String
  sourceVideoId   String
  startSec        Float
  endSec          Float
  title           String
  description     String?
  thumbnailKey    String?
  transcriptRef   String? // "<start>-<end>" window in the source transcript
  score           Float? // estimate only
  scoreReasons    Json?
  status          String   @default("candidate") // candidate | accepted | rejected
  favorite        Boolean  @default(false)
  editConfig      Json? // preset, aspect, subtitle style, trims
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVideo SourceVideo       @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  segments    SubtitleSegment[]
  jobs        RenderJob[]

  @@index([projectId])
  @@index([sourceVideoId])
}

model SubtitleSegment {
  id        String @id @default(cuid())
  clipId    String
  idx       Int
  startSec  Float // relative to clip start
  endSec    Float
  text      String
  wordsJson Json // [{w,s,e}] relative to clip start

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, idx])
}

model RenderJob {
  id             String    @id @default(cuid())
  userId         String
  projectId      String
  sourceVideoId  String?
  clipId         String?
  kind           JobKind
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  error          String?
  params         Json?
  outputKey      String?
  outputMeta     Json?
  tokenCost      Int       @default(0)
  idempotencyKey String?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVideo SourceVideo? @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  clip        Clip?        @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([projectId])
}

model TokenTransaction {
  id             String      @id @default(cuid())
  userId         String
  type           TokenTxType
  amount         Int // signed change to balance
  balanceAfter   Int
  reason         String
  refId          String? // job id or download id
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model SocialAccount {
  id                    String    @id @default(cuid())
  userId                String
  platform              String
  externalId            String
  displayName           String?
  scopes                String?
  accessTokenEnc        String // AES-256-GCM, never sent to the client
  refreshTokenEnc       String?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@unique([userId, platform, externalId])
}

model PublishJob {
  id              String    @id @default(cuid())
  socialAccountId String
  renderJobId     String
  caption         String?
  title           String?
  hashtags        String?
  privacy         String?
  scheduledAt     DateTime?
  status          String    @default("pending")
  platformPostId  String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WorkerHeartbeat {
  id     String   @id
  seenAt DateTime
  info   Json?
}
