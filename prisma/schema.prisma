generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER_ADMIN
}

enum JobStatus {
  queued
  validating
  downloading
  analyzing
  transcribing
  editing
  rendering
  completed
  failed
  cancelled
}

enum JobKind {
  ANALYZE
  RENDER
}

enum SourceKind {
  UPLOAD
  URL
}

enum AccessState {
  PROCESSABLE
  PREVIEW_ONLY
  AUTHORIZATION_REQUIRED
  UNSUPPORTED
}

enum TokenTxType {
  GRANT
  RESERVE
  CAPTURE
  REFUND
  CHARGE
  ADJUST
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String?   @unique // stored upper-case; currently only the owner admin has one
  name               String?
  passwordHash       String
  role               Role      @default(USER)
  mustChangePassword Boolean   @default(false)
  disabledAt         DateTime?
  tokenBalance       Int       @default(0)
  signupGrantedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  projects       Project[]
  tokenTxs       TokenTransaction[]
  socialAccounts SocialAccount[]
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
}

model Session {
  id        String   @id // sha256 of the cookie value, never the raw value
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id // sha256 of the emailed token
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVideos SourceVideo[]
  clips        Clip[]
  jobs         RenderJob[]
  mediaAssets  MediaAsset[]
  timelines    Timeline[]

  @@index([userId])
}

model SourceVideo {
  id           String      @id @default(cuid())
  projectId    String
  kind         SourceKind
  platform     String // upload | youtube | tiktok | instagram | facebook | direct
  sourceUrl    String?
  accessState  AccessState
  accessReason String?
  embedUrl     String?
  originalName String?
  storageKey   String? // relative path inside STORAGE_DIR, null when not processable
  mimeType     String?
  sizeBytes    BigInt?
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  hasAudio     Boolean?
  analysis     Json? // { silences: [{start,end}], scenes: [sec] } from ffmpeg silencedetect / scdet
  createdAt    DateTime    @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcript    Transcript?
  clips         Clip[]
  jobs          RenderJob[]
  timelineItems TimelineItem[]

  @@index([projectId])
}

model Transcript {
  id            String   @id @default(cuid())
  sourceVideoId String   @unique
  language      String?
  engine        String // e.g. faster-whisper:small
  text          String
  wordsJson     Json // [{w,s,e,p}] word timestamps from the model
  createdAt     DateTime @default(now())

  sourceVideo SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
}

model Clip {
  id              String   @id @default(cuid())
  projectId       String
  sourceVideoId   String
  startSec        Float
  endSec          Float
  title           String
  description     String?
  thumbnailKey    String?
  transcriptRef   String? // "<start>-<end>" window in the source transcript
  score           Float? // viral potential, estimate only
  hookScore       Float?
  engagementScore Float?
  hookText        String?
  targetDuration  Int? // 15 | 30 | 45 | 60 (or the speech length for very short sources)
  insights        Json? // { why, moments, momentsBasis, platforms }
  faceTrack       Json? // { start, end, keyframes, sampled, withFace, detector } cached for follow-face reframing
  scoreReasons    Json?
  status          String   @default("candidate") // candidate | accepted | rejected
  favorite        Boolean  @default(false)
  editConfig      Json? // preset, aspect, subtitle style, trims
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVideo SourceVideo       @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  segments    SubtitleSegment[]
  jobs        RenderJob[]
  timeline    Timeline?

  @@index([projectId])
  @@index([sourceVideoId])
}

model SubtitleSegment {
  id        String @id @default(cuid())
  clipId    String
  idx       Int
  startSec  Float // relative to clip start
  endSec    Float
  text      String
  wordsJson Json // [{w,s,e}] relative to clip start

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, idx])
}

model RenderJob {
  id             String    @id @default(cuid())
  userId         String
  projectId      String
  sourceVideoId  String?
  clipId         String?
  kind           JobKind
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  error          String?
  params         Json?
  outputKey      String?
  outputMeta     Json?
  tokenCost      Int       @default(0)
  idempotencyKey String?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVideo SourceVideo? @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  clip        Clip?        @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([projectId])
}

model TokenTransaction {
  id             String      @id @default(cuid())
  userId         String
  type           TokenTxType
  amount         Int // signed change to balance
  balanceAfter   Int
  reason         String
  refId          String? // job id or download id
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model SocialAccount {
  id              String    @id @default(cuid())
  userId          String
  platform        String
  externalId      String
  displayName     String?
  scopes          String?
  accessTokenEnc  String // AES-256-GCM, never sent to the client
  refreshTokenEnc String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@unique([userId, platform, externalId])
}

model PublishJob {
  id              String    @id @default(cuid())
  socialAccountId String
  renderJobId     String
  caption         String?
  title           String?
  hashtags        String?
  privacy         String?
  scheduledAt     DateTime?
  status          String    @default("pending")
  platformPostId  String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WorkerHeartbeat {
  id     String   @id
  seenAt DateTime
  info   Json?
}

// ---------- Phase 4: media library and multi-track timeline (additive) ----------

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
}

enum TrackType {
  VIDEO
  AUDIO
  SUBTITLE
  TEXT
  OVERLAY
  BROLL
  EFFECTS
  CARDS
}

/// A file in the user's media library. The file lives on disk under STORAGE_DIR, never in the DB.
model MediaAsset {
  id           String    @id @default(cuid())
  userId       String
  projectId    String? // set null when the project is deleted: the asset stays in the library
  kind         MediaKind
  name         String
  originalName String?
  storageKey   String
  thumbnailKey String?
  mimeType     String
  sizeBytes    BigInt
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  hasAudio     Boolean   @default(false)
  metadata     Json? // codec details from ffprobe
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   TimelineItem[]

  @@index([userId, createdAt])
  @@index([projectId])
}

/// One editing document per clip. Times inside are integer frames at `fps`.
model Timeline {
  id             String   @id @default(cuid())
  projectId      String
  clipId         String?  @unique
  name           String
  width          Int
  height         Int
  fps            Int      @default(30)
  durationFrames Int      @default(0)
  version        Int      @default(1) // bumped on every save; a stale version is refused
  playheadFrame  Int      @default(0)
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clip    Clip?            @relation(fields: [clipId], references: [id], onDelete: Cascade)
  tracks  TimelineTrack[]
  markers TimelineMarker[]

  @@index([projectId])
}

model TimelineTrack {
  id         String    @id
  timelineId String
  name       String
  type       TrackType
  order      Int // stacking: higher draws on top
  hidden     Boolean   @default(false)
  muted      Boolean   @default(false)
  locked     Boolean   @default(false)
  volume     Float     @default(1)
  config     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  timeline Timeline       @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  items    TimelineItem[]

  @@index([timelineId, order])
}

model TimelineItem {
  id             String   @id
  trackId        String
  kind           String // video | audio | image | text | effect
  mediaAssetId   String?
  sourceVideoId  String?
  startFrame     Int
  durationFrames Int
  sourceInFrame  Int      @default(0) // where the item starts inside its media, in timeline frames
  speed          Float    @default(1)
  opacity        Float    @default(1)
  volume         Float    @default(1)
  transform      Json? // { x, y, scale, rotation, fit, crop }
  effects        Json? // { fadeIn, fadeOut, effect: { type, intensity } }
  keyframes      Json? // [{ prop, frame, value, ease }]
  config         Json? // text item content and style
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  track       TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sourceVideo SourceVideo?  @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)

  @@index([trackId, startFrame])
  @@index([mediaAssetId])
  @@index([sourceVideoId])
}

model TimelineMarker {
  id         String   @id
  timelineId String
  frame      Int
  label      String   @default("")
  color      String   @default("#FF7A1A")
  createdAt  DateTime @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId, frame])
}
